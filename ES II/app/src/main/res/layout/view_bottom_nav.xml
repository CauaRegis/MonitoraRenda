<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Início (ativo) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navHome"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/mr_lime"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Início"
            android:src="@drawable/ic_home" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Registrar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navAdd"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/mr_divider"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Registrar corrida"
            android:src="@drawable/ic_plus" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Padrões -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navChart"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/mr_divider"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Padrões"
            android:src="@drawable/ic_chart" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Perfil -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navUser"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/mr_divider"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="Perfil"
            android:src="@drawable/ic_user" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>